# Example configuration. Every value here is fictional; the real ones come from the environment and never go in this repository.
SONIOX_API_KEY=example-soniox-key
ANTHROPIC_API_KEY=example-model-key
FAKE_PAYER_NUMBER=+12025550123
# A long random secret. It goes in the answer URL you give the telephony provider (https://HOST/answer?key=THIS); only requests carrying it are answered.
ANSWER_KEY=example-answer-key-change-me

# Limits (all optional; these are the defaults)
MAX_CONCURRENT_CALLS=3
MAX_CALLS_PER_NUMBER_PER_HOUR=120
MAX_CALL_SECONDS=300
DAILY_SPEND_CEILING_USD=5
LOG_RETENTION_DAYS=7
CALL_LOG_DIR=calls
TTS_VOICE=Mark
LISTEN_HOST=127.0.0.1
PORT=8080
COST_PER_MINUTE_USD=0.15
AUDIO_CACHE_DIR=audio_cache
